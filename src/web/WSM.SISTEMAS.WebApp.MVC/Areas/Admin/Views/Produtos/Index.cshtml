@model IEnumerable<WSM.SISTEMAS.WebApp.MVC.Models.Produtos.ProductItemViewModel>

@{
    ViewData["Title"] = "Gerenciamento de Produtos";
    var busca = ViewBag.Busca as string;
    var categoriaSelecionada = ViewBag.CategoriaSelecionada as string;
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1"><i class="fa-solid fa-boxes-stacked me-2 text-primary"></i> Catálogo de Produtos</h2>
        <p class="text-muted small mb-0">Gerencie todos os itens cadastrados no inventário da loja.</p>
    </div>
    <a asp-action="Novo" class="btn btn-amazon-primary">
        <i class="fa-solid fa-plus me-1"></i> Cadastrar Novo Produto
    </a>
</div>

<!-- Filtros e Pesquisa Amazon Style -->
<div class="amz-card">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-secondary"></i></span>
                <input type="text" name="busca" class="form-control border-start-0" placeholder="Buscar por nome ou descrição..." value="@busca" />
            </div>
        </div>

        <div class="col-md-4">
            <select name="categoria" class="form-select" onchange="this.form.submit()">
                <option value="">-- Todas as Categorias --</option>
                @foreach (var cat in categorias)
                {
                    if (cat == categoriaSelecionada)
                    {
                        <option value="@cat" selected="selected">@cat</option>
                    }
                    else
                    {
                        <option value="@cat">@cat</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-amazon-secondary w-100"><i class="fa-solid fa-filter me-1"></i> Filtrar</button>
            @if (!string.IsNullOrWhiteSpace(busca) || !string.IsNullOrWhiteSpace(categoriaSelecionada))
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpar Filtros"><i class="fa-solid fa-xmark"></i></a>
            }
        </div>
    </form>
</div>

<!-- Tabela de Produtos Amazon Style -->
<div class="amz-card p-0 overflow-hidden">
    <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary small">
            Exibindo <strong>@Model.Count()</strong> produto(s)
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fa-solid fa-box-open text-muted fs-1 mb-3"></i>
            <h5 class="fw-bold">Nenhum produto encontrado.</h5>
            <p class="text-muted small">Tente ajustar seus filtros de busca ou cadastre um novo item.</p>
            <a asp-action="Novo" class="btn btn-amazon-primary mt-2">Cadastrar Primeiro Produto</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="amz-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">Imagem</th>
                        <th>Produto</th>
                        <th>Categoria</th>
                        <th>Preço</th>
                        <th>Estoque</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 140px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var imgSrc = string.IsNullOrWhiteSpace(item.Imagem) || item.Imagem == "placeholder.png"
                            ? "https://via.placeholder.com/150?text=Sem+Imagem"
                            : (item.Imagem.StartsWith("http") ? item.Imagem : $"/uploads/produtos/{item.Imagem}");

                        <tr>
                            <td>
                                <img src="@imgSrc" alt="@item.Nome" class="amz-thumb" onError="this.src='https://via.placeholder.com/150?text=Sem+Imagem'" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark mb-1">@item.Nome</div>
                                <div class="text-muted small text-truncate" style="max-width: 320px;">@item.Descricao</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.TipoProduto</span>
                            </td>
                            <td>
                                <span class="amz-price">R$ @item.Valor.ToString("N2")</span>
                            </td>
                            <td>
                                @if (item.Estoque > 0)
                                {
                                    <span class="badge-stock-in"><i class="fa-solid fa-check me-1"></i> @item.Estoque em estoque</span>
                                }
                                else
                                {
                                    <span class="badge-stock-out"><i class="fa-solid fa-xmark me-1"></i> Esgotado</span>
                                }
                            </td>
                            <td>
                                @if (item.Ativo)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fw-semibold">Inativo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-amazon-secondary me-1" title="Editar Produto">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-amazon-danger" title="Excluir Produto"
                                        onclick="confirmarExclusao('@item.Id', '@JavaScriptEncoder.Default.Encode(item.Nome)')">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade" id="modalExclusao" tabindex="-1" aria-labelledby="modalExclusaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="modalExclusaoLabel"><i class="fa-solid fa-triangle-exclamation me-2"></i> Confirmar Exclusão</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-0">Tem certeza que deseja excluir o produto <strong id="nomeProdutoModal"></strong>?</p>
                <small class="text-muted">Esta ação é irreversível e removerá o item do catálogo.</small>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-amazon-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formExcluir" method="post" asp-action="Excluir">
                    <input type="hidden" id="idProdutoModal" name="id" value="" />
                    <button type="submit" class="btn btn-danger font-weight-bold"><i class="fa-solid fa-trash me-1"></i> Sim, Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarExclusao(id, nome) {
            document.getElementById('idProdutoModal').value = id;
            document.getElementById('nomeProdutoModal').innerText = nome;
            var modal = new bootstrap.Modal(document.getElementById('modalExclusao'));
            modal.show();
        }
    </script>
}
