@model UsuarioItemViewModel

@{
    ViewData["Title"] = "Excluir Usuário";
}

<div class="flex-grow flex items-center justify-center px-6 py-16">
    <div class="max-w-lg w-full bg-surface border-2 border-red-900/60 rounded-lg p-10 text-center">
        <div class="w-12 h-2 bg-red-600 mx-auto mb-6"></div>
        <h1 class="text-4xl font-display text-white tracking-widest mb-2">Excluir Usuário</h1>
        <p class="text-slate-400 mb-6">
            Tem certeza que deseja excluir <strong class="text-white">@Model.Nome</strong>
            (@Model.Email)? Esta ação não pode ser desfeita.
        </p>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="flex justify-center gap-4">
            @Html.AntiForgeryToken()
            <button type="submit" class="bg-red-600 text-white px-8 py-3 border-2 border-red-600 hover:bg-transparent hover:text-red-400 transition-all text-sm font-bold tracking-widest">
                Excluir
            </button>
            <a asp-action="Index" class="border-2 border-line text-slate-400 hover:border-primary hover:text-white px-8 py-3 transition-all text-sm font-bold tracking-widest">
                Cancelar
            </a>
        </form>
    </div>
</div>
