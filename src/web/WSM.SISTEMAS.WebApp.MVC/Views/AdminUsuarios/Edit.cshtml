@model UsuarioFormViewModel

@{
    ViewData["Title"] = "Editar Usuário";
}

<div class="max-w-screen-lg mx-auto px-6 py-12 flex-grow w-full">
    <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-bold tracking-widest text-slate-500 hover:text-primary transition-colors mb-8">
        <span aria-hidden="true">&larr;</span> VOLTAR
    </a>

    <div class="w-12 h-2 bg-primary mb-6"></div>
    <h1 class="text-6xl font-display text-white tracking-widest mb-10">Editar Usuário</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-6">
        @await Component.InvokeAsync("ValidationSummary")

        <div class="space-y-2">
            <label asp-for="Nome" class="block text-sm font-bold text-slate-500 tracking-widest">Nome</label>
            <input asp-for="Nome" class="w-full bg-deep border-2 border-line px-4 py-3 focus:outline-none focus:border-primary transition-colors text-white placeholder-slate-700" placeholder="Ex.: Maria Silva" />
            <span asp-validation-for="Nome" class="text-primary-light text-xs mt-2 block font-bold tracking-widest"></span>
        </div>

        <div class="space-y-2">
            <label asp-for="Email" class="block text-sm font-bold text-slate-500 tracking-widest">E-mail</label>
            <input asp-for="Email" type="email" class="w-full bg-deep border-2 border-line px-4 py-3 focus:outline-none focus:border-primary transition-colors text-white placeholder-slate-700" placeholder="usuario@wsm.com" />
            <span asp-validation-for="Email" class="text-primary-light text-xs mt-2 block font-bold tracking-widest"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex items-center gap-3">
                <input asp-for="EhAdmin" type="checkbox" class="w-5 h-5 accent-[#2563EB] bg-deep border-2 border-line" />
                <label asp-for="EhAdmin" class="text-sm font-bold text-slate-300 tracking-widest">Administrador</label>
            </div>

            <div class="flex items-center gap-3">
                <input asp-for="Bloqueado" type="checkbox" class="w-5 h-5 accent-[#dc2626] bg-deep border-2 border-line" />
                <label asp-for="Bloqueado" class="text-sm font-bold text-slate-300 tracking-widest">Bloquear (impede o login)</label>
            </div>
        </div>

        <div class="bg-amber-950/30 border-2 border-amber-900/60 text-amber-300/90 text-sm font-bold tracking-widest px-4 py-3">
            ALTERAÇÕES DE PERFIL E PERMISSÕES VALEM A PARTIR DO PRÓXIMO LOGIN OU RENOVAÇÃO DE SESSÃO.
        </div>

        <div class="flex gap-4 pt-6">
            <button type="submit" class="bg-primary text-white px-8 py-3 border-2 border-primary hover:bg-transparent hover:text-primary transition-all text-sm font-bold tracking-widest">
                Salvar Alterações
            </button>
            <a asp-action="Index" class="border-2 border-line text-slate-400 hover:border-primary hover:text-white px-8 py-3 transition-all text-sm font-bold tracking-widest">
                Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
