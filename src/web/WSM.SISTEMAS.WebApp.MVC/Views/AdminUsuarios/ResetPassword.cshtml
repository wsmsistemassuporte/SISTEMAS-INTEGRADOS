@model UsuarioFormViewModel

@{
    ViewData["Title"] = "Resetar Senha";
}

<div class="flex-grow flex items-center justify-center px-6 py-16">
    <div class="max-w-lg w-full bg-surface border-2 border-amber-900/60 rounded-lg p-10">
        <div class="w-12 h-2 bg-amber-600 mx-auto mb-6"></div>
        <h1 class="text-4xl font-display text-white tracking-widest mb-2 text-center">Resetar Senha</h1>
        <p class="text-slate-400 text-center mb-8">
            Definir nova senha para <strong class="text-white">@Model.Nome</strong> (@Model.Email).
        </p>

        <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" class="space-y-6">
            @await Component.InvokeAsync("ValidationSummary")

            <div class="space-y-2">
                <label asp-for="NovaSenha" class="block text-sm font-bold text-slate-500 tracking-widest">Nova Senha</label>
                <input asp-for="NovaSenha" type="password" class="w-full bg-deep border-2 border-line px-4 py-3 focus:outline-none focus:border-primary transition-colors text-white placeholder-slate-700" placeholder="Mínimo 6 caracteres" />
                <span asp-validation-for="NovaSenha" class="text-primary-light text-xs mt-2 block font-bold tracking-widest"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="ConfirmarNovaSenha" class="block text-sm font-bold text-slate-500 tracking-widest">Confirmação da Nova Senha</label>
                <input asp-for="ConfirmarNovaSenha" type="password" class="w-full bg-deep border-2 border-line px-4 py-3 focus:outline-none focus:border-primary transition-colors text-white placeholder-slate-700" placeholder="Repita a nova senha" />
                <span asp-validation-for="ConfirmarNovaSenha" class="text-primary-light text-xs mt-2 block font-bold tracking-widest"></span>
            </div>

            <div class="bg-amber-950/30 border-2 border-amber-900/60 text-amber-300/90 text-sm font-bold tracking-widest px-4 py-3">
                O USUÁRIO SERÁ DESCONECTADO E PRECISARÁ ENTRAR COM A NOVA SENHA.
            </div>

            <div class="flex justify-center gap-4 pt-2">
                <button type="submit" class="bg-primary text-white px-8 py-3 border-2 border-primary hover:bg-transparent hover:text-primary transition-all text-sm font-bold tracking-widest">
                    Redefinir Senha
                </button>
                <a asp-action="Index" class="border-2 border-line text-slate-400 hover:border-primary hover:text-white px-8 py-3 transition-all text-sm font-bold tracking-widest">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
