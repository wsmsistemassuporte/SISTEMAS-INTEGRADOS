@model RegisterViewModel

@{
    ViewData["Title"] = "Criar conta";
}

<div class="flex-grow bp-grid flex items-center justify-center px-4 py-12 md:py-16">
    <div class="w-full max-w-md">
        <div class="flex justify-center mb-8">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5" aria-label="WSM Store — Início">
                <span class="grid place-items-center w-10 h-10 rounded-xl bg-brand text-white font-display font-extrabold text-sm shadow-soft">WSM</span>
                <span class="text-xl font-bold tracking-tight">WSM <span class="font-medium text-mute">Store</span></span>
            </a>
        </div>

        <div class="card shadow-soft-lg p-6 sm:p-8">
            <h1 class="font-display text-2xl font-bold tracking-tight text-center">Criar conta</h1>
            <p class="mt-1.5 text-sm text-mute text-center">Junte-se à WSM Store.</p>

            <form asp-action="Register" method="post" class="mt-8 space-y-5">
                @await Component.InvokeAsync("ValidationSummary")

                <div>
                    <label asp-for="Nome" class="field-label">Nome</label>
                    <input asp-for="Nome" class="field" placeholder="Como devemos chamá-lo" autocomplete="name" />
                    <span asp-validation-for="Nome" class="field-error"></span>
                </div>

                <div>
                    <label asp-for="Email" class="field-label">E-mail</label>
                    <input asp-for="Email" class="field" placeholder="seu@email.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div>
                    <label asp-for="Password" class="field-label">Senha</label>
                    <input asp-for="Password" class="field" placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="field-label">Confirmar senha</label>
                    <input asp-for="ConfirmPassword" class="field" placeholder="Repita a senha" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-full">Registrar</button>
            </form>

            <p class="mt-6 text-center text-sm text-mute">
                Já tem conta?
                <a asp-action="Login" class="font-semibold text-brand hover:text-brand-dark transition-colors">Entrar na WSM</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
