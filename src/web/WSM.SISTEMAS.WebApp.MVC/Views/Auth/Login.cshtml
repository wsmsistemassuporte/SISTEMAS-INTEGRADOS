@model LoginViewModel

@{
    ViewData["Title"] = "Entrar";
}

<div class="flex-grow bp-grid flex items-center justify-center px-4 py-12 md:py-16">
    <div class="w-full max-w-md">
        <div class="flex justify-center mb-8">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5" aria-label="WSM Store — Início">
                <span class="grid place-items-center w-10 h-10 rounded-xl bg-brand text-white font-display font-extrabold text-sm shadow-soft">WSM</span>
                <span class="text-xl font-bold tracking-tight">WSM <span class="font-medium text-mute">Store</span></span>
            </a>
        </div>

        <div class="card shadow-soft-lg p-6 sm:p-8">
            <h1 class="font-display text-2xl font-bold tracking-tight text-center">Entrar na WSM</h1>
            <p class="mt-1.5 text-sm text-mute text-center">Acesse sua conta para acompanhar seus dados.</p>

            <form asp-action="Login" method="post" class="mt-8 space-y-5">
                <input type="hidden" asp-for="ReturnUrl" />
                @await Component.InvokeAsync("ValidationSummary")

                <div>
                    <label asp-for="Email" class="field-label">E-mail</label>
                    <input asp-for="Email" class="field" placeholder="seu@email.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div>
                    <label asp-for="Password" class="field-label">Senha</label>
                    <input asp-for="Password" class="field" placeholder="Sua senha de acesso" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="flex items-center gap-2.5">
                    <input asp-for="RememberMe" class="w-4 h-4 rounded accent-brand cursor-pointer" />
                    <label asp-for="RememberMe" class="text-sm text-slate-600 cursor-pointer">Manter conectado</label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-full">Acessar</button>
            </form>

            <p class="mt-6 text-center text-sm text-mute">
                Ainda não tem conta?
                <a asp-action="Register" class="font-semibold text-brand hover:text-brand-dark transition-colors">Criar conta</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
