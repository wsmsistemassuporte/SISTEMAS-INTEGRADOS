@model ProductItemViewModel

@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="flex-grow flex items-center justify-center px-4 py-16">
    <div class="max-w-lg w-full text-center card shadow-soft-lg p-10">
        <div class="mx-auto grid place-items-center w-14 h-14 rounded-2xl bg-red-50 text-danger mb-6">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
        </div>

        <h1 class="font-display text-2xl font-bold tracking-tight">Excluir produto</h1>
        <p class="mt-2 text-mute leading-relaxed">
            Tem certeza que deseja excluir <strong class="text-ink">@Model.Nome</strong>
            (<span class="font-mono">@Model.PrecoFormatado</span>)? Esta ação não pode ser desfeita.
        </p>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="mt-8 flex justify-center gap-3 flex-wrap">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger btn-lg">Excluir</button>
            <a asp-action="Index" class="btn btn-ghost btn-lg">Cancelar</a>
        </form>
    </div>
</div>
