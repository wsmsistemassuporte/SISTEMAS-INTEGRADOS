@model ProductFormViewModel

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="max-w-screen-lg mx-auto px-4 sm:px-6 py-12 flex-grow w-full">
    <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-medium text-mute hover:text-brand transition-colors mb-8">
        <span aria-hidden="true">&larr;</span> Voltar
    </a>

    <p class="eyebrow">→ Administração</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight mb-8">Editar produto</h1>

    <div class="card shadow-soft p-6 sm:p-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-6">
            @await Component.InvokeAsync("ValidationSummary")

            <div>
                <label asp-for="Nome" class="field-label">Nome</label>
                <input asp-for="Nome" class="field" />
                <span asp-validation-for="Nome" class="field-error"></span>
            </div>

            <div>
                <label asp-for="Descricao" class="field-label">Descrição</label>
                <textarea asp-for="Descricao" rows="4" class="field"></textarea>
                <span asp-validation-for="Descricao" class="field-error"></span>
            </div>

            <div>
                <label asp-for="Imagem" class="field-label">URL da Imagem</label>
                <input asp-for="Imagem" class="field" placeholder="https://..." />
                <span asp-validation-for="Imagem" class="field-error"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <label asp-for="TipoProduto" class="field-label">Categoria</label>
                    <select asp-for="TipoProduto" asp-items="ViewBag.Categorias" class="field">
                        <option value="">Selecione...</option>
                    </select>
                    <span asp-validation-for="TipoProduto" class="field-error"></span>
                </div>

                <div>
                    <label asp-for="Preco" class="field-label">Preço (R$)</label>
                    <input asp-for="Preco" type="number" step="0.01" min="0" class="field" />
                    <span asp-validation-for="Preco" class="field-error"></span>
                </div>

                <div>
                    <label asp-for="QuantidadeEstoque" class="field-label">Estoque</label>
                    <input asp-for="QuantidadeEstoque" type="number" min="0" class="field" />
                    <span asp-validation-for="QuantidadeEstoque" class="field-error"></span>
                </div>
            </div>

            <div class="flex flex-wrap gap-3 pt-2">
                <button type="submit" class="btn btn-primary btn-lg">Salvar alterações</button>
                <a asp-action="Index" class="btn btn-ghost btn-lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
